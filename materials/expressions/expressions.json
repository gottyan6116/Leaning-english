      "dialogue": [
        {
          "speaker": "A",
          "text": "What do you think about the new schedule?"
        },
        {
          "speaker": "B",
          "text": "I think it gives us more time to prepare."
        },
        {
          "speaker": "A",
          "text": "Good point. Let's try it."
        },
        {
          "speaker": "B",
          "text": "Great. I'll update the plan today."
